{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simulator:schema:authorizations:1.0.0",
  "title": "Internal refund authorizations",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "const": "authorizations"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "authorization_id",
        "subject_kind",
        "subject_ref",
        "approved_by",
        "approved_at",
        "max_amount",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "authorization_id": {
          "type": "string",
          "pattern": "^AUT-[0-9]{6}$"
        },
        "subject_kind": {
          "type": "string",
          "enum": [
            "refund"
          ]
        },
        "subject_ref": {
          "type": "string",
          "minLength": 1
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "description": "UTC instant"
        },
        "max_amount": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "description": "Positive decimal string with exactly 2 places"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code"
        }
      }
    }
  }
}
