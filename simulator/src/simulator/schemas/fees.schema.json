{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simulator:schema:fees:1.0.0",
  "title": "Gateway fees, one per payment",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "const": "fees"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "fee_id",
        "payment_ref",
        "gateway",
        "fee_type",
        "amount",
        "currency",
        "settlement_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "fee_id": {
          "type": "string",
          "pattern": "^FEE-[0-9]{6}$"
        },
        "payment_ref": {
          "type": "string",
          "minLength": 1
        },
        "gateway": {
          "type": "string",
          "minLength": 1
        },
        "fee_type": {
          "type": "string",
          "enum": [
            "processing"
          ]
        },
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "description": "Positive decimal string with exactly 2 places"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code"
        },
        "settlement_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
